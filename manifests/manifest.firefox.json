{
  "manifest_version": 2,
  "name": "Remine Helper",
  "version": "1.0.3",
  "description": "Shortcuts and Notifications for Rescene Fans, Remine.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://gist.githubusercontent.com/*",
    "https://duckbeginner.github.io/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "browser_action": {
    "default_title": "Click to open sidebar",
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    }
  },
  "sidebar_action": {
    "default_title": "Remine Helper",
    "default_icon": "icons/logo32.png",
    "default_panel": "sidepanel.html"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; frame-src 'self' https://adam-yam.github.io https://clip.naver.com https://*.youtube.com https://*.instagram.com https://www.tiktok.com https://*.x.com https://platform.twitter.com https://syndication.twitter.com;",
  "browser_specific_settings": {
    "gecko": {
      "id": "{8e25f021-4c94-49f8-91b7-18f5f3e5a810}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
