{
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "chrome": "readonly",
    "browser": "readonly"
  },
  "ignorePatterns": [
    "*복사본*/**",
    "remine-helper-extension*/**",
    "publish/**",
    "node_modules/**",
    ".cache/**"
  ],
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ]
  }
}
