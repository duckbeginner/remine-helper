{
  "manifest_version": 3,
  "name": "Remine Helper",
  "version": "1.0.3",
  "description": "For Remine",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://gist.githubusercontent.com/*",
    "https://duckbeginner.github.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_title": "Click to open sidebar",
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://duckbeginner.github.io https://adam-yam.github.io https://clip.naver.com https://*.youtube.com https://*.instagram.com https://*.tiktok.com https://*.x.com https://platform.twitter.com https://syndication.twitter.com;"
  }
}