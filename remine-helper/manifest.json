{
  "manifest_version": 3,
  "name": "Remine Helper",
  "version": "1.0.2",
  "description": "For Remine",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.youtube.com/feeds/*",
    "https://blip.kr/*",
    "https://*.mnetplus.world/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_title": "Click to open sidebar",
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://adam-yam.github.io https://clip.naver.com https://*.youtube.com https://*.instagram.com https://www.tiktok.com https://*.mnetplus.world https://blip.kr https://*.bstage.in https://*.x.com https://platform.twitter.com https://platform.x.com https://syndication.twitter.com;"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
